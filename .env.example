NODE_ENV=development
PORT=3001

# Your deployed URL (no trailing slash) — used in email links and CORS
# Local dev: http://localhost:5173
# Production: https://your-app.up.railway.app
APP_URL=http://localhost:5173

# SQLite database path
# Production on Railway: set this to /data/sentra.db and add a volume at /data
DB_PATH=./sentra.db

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Anthropic (Claude AI) — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Email (SMTP) — for dev use Ethereal: https://ethereal.email
# Production: use Resend (resend.com) — free up to 3,000 emails/month
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your@ethereal.email
SMTP_PASS=yourpassword
EMAIL_FROM="Sentra <alerts@sentra.app>"

# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_FAMILY_PLUS=price_...
# Get webhook secret by running: stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
