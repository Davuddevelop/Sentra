{
  "manifest_version": 3,
  "name": "Sentra Child Safety Monitor",
  "version": "1.0.0",
  "description": "Monitors AI chatbot usage patterns on your child's device. Never reads message content — metadata only.",

  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://character.ai/*",
    "https://www.character.ai/*",
    "https://beta.character.ai/*",
    "https://replika.com/*",
    "https://www.replika.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.bing.com/chat*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://character.ai/*", "https://www.character.ai/*", "https://beta.character.ai/*"],
      "js": ["content/characterai.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://replika.com/*", "https://www.replika.com/*"],
      "js": ["content/replika.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://copilot.microsoft.com/*", "https://www.bing.com/chat*"],
      "js": ["content/copilot.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sentra-peach-delta.vercel.app/install/*",
        "http://localhost:3001/install/*",
        "http://localhost:5173/install/*"
      ],
      "js": ["content-install.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentra Monitor"
  },

  "options_page": "options.html",

  "externally_connectable": {
    "matches": ["https://sentra-peach-delta.vercel.app/*"]
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
